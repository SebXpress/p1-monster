<?xml version="1.0" encoding="utf-8"?>
<!-- Estilos reutilizables de la app (Grupo 1 - NRC 36841) -->
<resources>
    <style name="Etiqueta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">@color/tenue</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/campo</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">@color/tenue</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="BotonMenu" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/oscuro</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">22dp</item>
        <item name="cornerRadius">16dp</item>
    </style>
</resources>
