<?xml version="1.0" encoding="utf-8"?>
<!-- Facturación: teléfonos, comprador y forma de pago (efectivo o crédito directo) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include layout="@layout/cabecera" />

    <ProgressBar
        android:id="@+id/progreso"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/dorado"
        android:visibility="invisible" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Teléfonos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/tarjeta"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Teléfonos"
                    android:textColor="@color/dorado"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/cboCelular"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/campo"
                    android:popupBackground="@color/panel2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/txtCantidad"
                        style="@style/Campo"
                        android:layout_width="90dp"
                        android:layout_marginTop="0dp"
                        android:gravity="center"
                        android:inputType="number"
                        android:text="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAgregar"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/azul"
                        android:text="Agregar"
                        android:textColor="@color/oscuro"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/listaCarrito"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/lblTotales"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="end"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/texto"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/lblTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="$ 0.00"
                    android:textColor="@color/dorado"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Comprador -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/tarjeta"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Comprador"
                    android:textColor="@color/dorado"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView style="@style/Etiqueta" android:text="Cédula *" />
                <EditText android:id="@+id/txtCedula" style="@style/Campo" android:hint="10 dígitos" android:inputType="number" android:maxLength="10" />

                <TextView style="@style/Etiqueta" android:text="Nombre *" />
                <EditText android:id="@+id/txtNombre" style="@style/Campo" android:inputType="textCapCharacters" />

                <TextView style="@style/Etiqueta" android:text="Dirección" />
                <EditText android:id="@+id/txtDireccion" style="@style/Campo" android:inputType="textPostalAddress" />

                <TextView style="@style/Etiqueta" android:text="Teléfono" />
                <EditText android:id="@+id/txtTelefono" style="@style/Campo" android:inputType="phone" />

                <TextView style="@style/Etiqueta" android:text="Correo" />
                <EditText android:id="@+id/txtCorreo" style="@style/Campo" android:inputType="textEmailAddress" />
            </LinearLayout>

            <!-- 3. Forma de pago -->
            <LinearLayout
                android:id="@+id/tarjetaPago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/tarjeta"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Forma de pago"
                    android:textColor="@color/dorado"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/grupoPago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <RadioButton
                        android:id="@+id/rbEfectivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/verde"
                        android:checked="true"
                        android:text="💵 Efectivo (42 % de descuento)"
                        android:textColor="@color/texto" />

                    <RadioButton
                        android:id="@+id/rbCredito"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/cian"
                        android:text="🏦 Crédito directo · Banco BanQuito"
                        android:textColor="@color/texto" />
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/panelCredito"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView style="@style/Etiqueta" android:text="Número de cuotas (3 a 18 meses)" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/txtCuotas"
                            style="@style/Campo"
                            android:layout_width="90dp"
                            android:layout_marginTop="0dp"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="2"
                            android:text="6" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEvaluar"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/cian"
                            android:text="Consultar al banco"
                            android:textColor="@color/oscuro"
                            android:textStyle="bold"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/lblCuota"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/cian"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lblMensaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/tenue"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLimpiar"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:backgroundTint="@color/panel2"
            android:text="Limpiar"
            android:textColor="@color/texto"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFacturar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:backgroundTint="@color/verde"
            android:text="FACTURAR"
            android:textColor="@color/oscuro"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>
